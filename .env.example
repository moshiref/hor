# — Frontend (public) — لا تضع أسرار هنا
# للتطوير المحلي فقط — لا يُستخدم في الإنتاج
# VITE_API_URL=http://localhost:3000/api
VITE_SITE_URL=http://localhost:5173

# — Supabase (للإنتاج الحقيقي — بديل التخزين المحلي)
# عند ضبطهما يعمل الموقع ولوحة التحكم بقاعدة بيانات مشتركة وتخزين سحابي — بدونهما يعمل بالتخزين المحلي للجهاز فقط
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# — Backend (server-only) — لا تضعها في VITE_ ولا في Frontend
# DATABASE_URL=postgresql://user:password@localhost:5432/hor_alain
# JWT_SECRET=change-me-64-chars-random
# SESSION_SECRET=change-me-64-chars-random
# ENCRYPTION_KEY=32-bytes-base64-key-for-PII
# RATE_LIMIT_WINDOW_MS=3600000
# RATE_LIMIT_MAX=5
